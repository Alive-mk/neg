{
  "target_examples": 120,
  "batch_size": 5,
  "max_retries_per_batch": 4,
  "generation_model": "generator",
  "verifier_model": "verifier",
  "semantic_mode_mix": {
    "contrastive_resolution": 1.0
  },
  "scope_weights": {
