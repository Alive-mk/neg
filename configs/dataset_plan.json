{
  "target_examples": 6000,
  "batch_size": 6,
  "max_retries_per_batch": 4,
  "generation_model": "generator",
  "verifier_model": null,
  "semantic_mode_mix": {
    "suppression_only": 0.4,
    "contrastive_resolution": 0.35,
    "exclusive_choice": 0.25
  },
  "neg_types": [
    "verb",
    "noun",
    "adverb",
    "sentential"
  ],
  "scope_types": [
    "in_scope",
    "out_of_scope",
    "double_negation"
  ],
  "domains": [
    "factual",
    "commonsense",
    "lexical",
    "instructional"
  ],
  "seed_topics_path": "resources/seed_topics.json",
  "verifier_threshold": 0.7,
  "random_seed": 42
}
